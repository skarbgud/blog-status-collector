{
  "name": "blog-stat-extension",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "네이버 블로그 통계를 내 브라우저 안에서 수집·저장·조회하는 크롬 확장",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-static.mjs",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "tsc -p tsconfig.test.json && node --test build-test/test/"
  },
  "devDependencies": {
    "@types/chrome": "0.3.7",
    "@types/node": "20.19.43",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@sqlite.org/sqlite-wasm": "3.53.4-build2"
  }
}
